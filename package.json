{
  "name": "vyron",
  "private": true,
  "version": "0.4.1",
  "vyronVersion": "0.4.1",
  "description": "Vyron — open-source web UI and touchscreen UI for Klipper printers, with a small host service",
  "workspaces": [
    "apps/web",
    "apps/screen",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @vyron/web --",
    "dev:demo": "npm run dev:demo -w @vyron/web --",
    "build": "npm run build -w @vyron/web --",
    "build:demo": "npm run build:demo -w @vyron/web --",
    "dev:screen": "npm run dev -w @vyron/screen --",
    "build:screen": "npm run build -w @vyron/screen --",
    "build:screen:demo": "npm run build:demo -w @vyron/screen --"
  }
}
