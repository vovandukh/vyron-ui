# Vyron Screen на екрані принтера. Створює install/screen.sh.
# Якщо Vyron Screen падає 4 рази поспіль за 2 хвилини — система сама повертає KlipperScreen.
# Звичайна зупинка чи перезапуск (systemctl stop/restart) збоєм не вважаються: xinit, отримавши
# SIGTERM, виходить з кодом 1 — тому коди 1/2 і сигнали завершення рахуються як нормальний вихід.
[Unit]
Description=Vyron Screen (екран принтера)
After=nginx.service moonraker.service
Conflicts=KlipperScreen.service
OnFailure=KlipperScreen.service
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
User=@USER@
@GROUPS@
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
# 1 — плата з відеокартою (install.sh --gpu): браузер малює через неї; 0 — процесором
Environment=VYRON_GPU=@GPU@
ExecStart=/usr/bin/xinit @KIOSK@ @URL@ -- :0 -nolisten tcp -nocursor
Restart=always
SuccessExitStatus=1 2 SIGTERM SIGINT SIGHUP
RestartSec=3
# Klipper важливіший за екран: менший пріоритет на процесор, а якщо забракне пам'яті —
# система першим зупинить браузер (systemd його перезапустить), а не Klipper
Nice=5
CPUWeight=50
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
